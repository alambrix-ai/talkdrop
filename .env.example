NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://talkdrop:talkdrop@localhost:5432/talkdrop

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
TRUST_TOKEN_SECRET=change-me-trust-secret-min-32-chars
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_MOCK=true

# S3 / MinIO (evidence only)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talkdrop-evidence
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1
S3_MOCK=true

# Providers (mock in development)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
AGE_PROVIDER=mock
MODERATION_PROVIDER=mock

# Moderation thresholds
MOD_NUDITY_CUT=0.85
MOD_NUDITY_REVIEW=0.6
MOD_TOXICITY_CUT=0.9

# Product config
EVIDENCE_TTL_HOURS=24
BLUR_FIRST_SECONDS=15
MATCH_WIDEN_AFTER_MS=8000
MATCH_INTERVAL_MS=300

# Origins
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
API_PORT=4000

# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_RT_URL=http://localhost:4000/rt
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_LIVEKIT_MOCK=true
