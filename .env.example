NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://talkdrop:talkdrop@localhost:5432/talkdrop

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
TRUST_TOKEN_SECRET=change-me-trust-secret-min-32-chars
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# LiveKit — real SFU by default (Compose service `livekit` on :7880).
# Set LIVEKIT_MOCK=true only for offline unit tests without the SFU.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_MOCK=false

# S3 / MinIO (evidence only)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talkdrop-evidence
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1
S3_MOCK=true

# Providers
# SMS: mock | twilio | messagebird  (mock only when SMS_PROVIDER=mock)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=Talkdrop

EMAIL_PROVIDER=mock

# Age: ondevice | mock  (see docs/AGE_VERIFICATION.md)
AGE_PROVIDER=ondevice
AGE_DOCUMENT_REDIRECT_URL=

MODERATION_PROVIDER=mock

# Captions STT: local | deepgram | whisper
STT_PROVIDER=local
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
WHISPER_MODEL=whisper-1

# Translation MT: mymemory | libretranslate | identity | local
MT_PROVIDER=mymemory
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Moderation thresholds
MOD_NUDITY_CUT=0.85
MOD_NUDITY_REVIEW=0.6
MOD_TOXICITY_CUT=0.9
# Chaos: force server-side cut on next tap cycle
# MOD_FORCE_FLAG=1

# Product config
EVIDENCE_TTL_HOURS=24
BLUR_FIRST_SECONDS=15
MATCH_WIDEN_AFTER_MS=8000
MATCH_INTERVAL_MS=300

# Origins
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
API_PORT=4000

# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_RT_URL=http://localhost:4000/rt
VITE_LIVEKIT_URL=ws://localhost:7880
# false = join real LiveKit rooms from the call UI
VITE_LIVEKIT_MOCK=false

# Billing — intentionally deferred / mock only (do not set stripe|razorpay yet)
BILLING_PROVIDER=mock

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
