NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://talkdrop:talkdrop@localhost:5432/talkdrop

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets — generate unique values for every environment.
# Production refuses placeholders / change-me / all-A keys (see apps/api/src/config.ts).
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-prod-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-before-prod-32
TRUST_TOKEN_SECRET=dev-only-trust-secret-replace-before-prod-32b
# openssl rand -base64 32  (≥32 decoded bytes for AES-256-GCM evidence + phone)
FIELD_ENCRYPTION_KEY=dGFsa2Ryb3AtZGV2LWZpZWxkLWtleS0zMmJ5dGVzISE=
# Shared secret for /internal/livekit/webhook and /api/v1/billing/webhook
# Header: X-Talkdrop-Webhook-Secret
INTERNAL_WEBHOOK_SECRET=dev-only-webhook-secret-replace

# LiveKit — real SFU by default (Compose service `livekit` on :7880).
# Set LIVEKIT_MOCK=true only for offline unit tests without the SFU.
# Media is SFU-mediated (trusted SFU + server mod tap) — NOT classic E2EE.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-not-for-prod
LIVEKIT_MOCK=false

# S3 / MinIO (encrypted evidence only)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talkdrop-evidence
S3_ACCESS_KEY=minio
S3_SECRET_KEY=dev-only-minio-secret
S3_REGION=us-east-1
S3_MOCK=true

# Providers
# SMS: mock | twilio | messagebird  (kept for age-verification phone fallback only;
# phone OTP is no longer used for sign-in)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=Talkdrop

EMAIL_PROVIDER=mock

# Sign in with Google (primary auth). Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized redirect URI must be: {API_ORIGIN}/api/v1/auth/google/callback
# e.g. http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/CI only — enables POST /auth/google/mock without real Google credentials.
# Forced off in production. Also auto-on when NODE_ENV=test.
GOOGLE_OAUTH_MOCK=true

# Age: ondevice | mock  (mock forbidden in production — see docs/AGE_VERIFICATION.md)
AGE_PROVIDER=ondevice
AGE_DOCUMENT_REDIRECT_URL=

MODERATION_PROVIDER=mock

# Captions STT: local | deepgram | whisper
STT_PROVIDER=local
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
WHISPER_MODEL=whisper-1

# Translation MT: mymemory | libretranslate | identity | local
MT_PROVIDER=mymemory
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Moderation thresholds
MOD_NUDITY_CUT=0.85
MOD_NUDITY_REVIEW=0.6
MOD_TOXICITY_CUT=0.9
# Chaos: force server-side cut on next tap cycle
# MOD_FORCE_FLAG=1

# Product config
EVIDENCE_TTL_HOURS=24
BLUR_FIRST_SECONDS=15
MATCH_WIDEN_AFTER_MS=8000
MATCH_INTERVAL_MS=300

# Origins — production CORS allows only WEB_ORIGIN
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
API_PORT=4000

# Web (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_RT_URL=http://localhost:4000/rt
VITE_LIVEKIT_URL=ws://localhost:7880
# false = join real LiveKit rooms from the call UI
VITE_LIVEKIT_MOCK=false

# Billing — intentionally deferred / mock only (do not set stripe|razorpay yet)
# Webhook still requires INTERNAL_WEBHOOK_SECRET
BILLING_PROVIDER=mock

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
